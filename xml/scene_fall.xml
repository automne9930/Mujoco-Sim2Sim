<mujoco model="go2w fall scene">
  <!-- 斜坡 + 高台摔落测试场景：机器人本体见 go2w.xml -->
  <include file="go2w.xml" />

  <!-- 全局默认摩擦（滑动 / 扭转 / 滚动），与 scene.xml 保持一致 -->
  <default>
    <geom friction="1.5 0.005 0.0001" />
  </default>

  <visual>
    <global offwidth="3840" offheight="2160" />
    <rgba haze="0.15 0.25 0.35 1" />
  </visual>

  <asset>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
    <material name="ramp" rgba="0.72 0.45 0.20 1" />
    <material name="platform" rgba="0.42 0.50 0.62 1" />
    <material name="edge_mark" rgba="0.90 0.15 0.10 1" />
  </asset>

  <worldbody>
    <light pos="0 0 4.5" dir="0 0 -1" directional="true" />
    <light pos="6 6 4.0" dir="-0.5 -0.5 -1" directional="true" diffuse="0.35 0.35 0.35" />
    <geom name="floor" type="plane" size="20 20 0.05" material="groundplane" />

    <!-- ==================== 斜坡：x∈[2.0, 5.0]，由地面爬升到 1.0 m ==================== -->
    <!-- 倾角 atan(1.0/3.0)≈18.43°，斜面长 sqrt(10)≈3.162 m，宽 1.5 m，板厚 0.1 m -->
    <!-- 斜面上表面恰好从 (2.0, 0, 0) 连到 (5.0, 0, 1.0) -->
    <geom name="ramp" type="box" size="1.581139 0.750 0.050"
          pos="3.515811 0 0.452566"
          quat="0.987126 0 -0.160182 0"
          material="ramp" />

    <!-- ==================== 高台：x∈[5.0, 7.5]，顶面高 1.0 m ==================== -->
    <geom name="platform" type="box" size="1.250 0.750 0.500"
          pos="6.250 0 0.500"
          material="platform" />

    <!-- 高台跌落边缘的红色警示条（仅视觉，不参与碰撞） -->
    <geom name="edge_mark" type="box" size="0.050 0.750 0.002"
          pos="7.450 0 1.002" material="edge_mark"
          contype="0" conaffinity="0" group="1" />
  </worldbody>
</mujoco>
